# Solo para desarrollo local. No reutilices estos valores en producción.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/helpdesk
SPRING_DATASOURCE_USERNAME=helpdesk
SPRING_DATASOURCE_PASSWORD=helpdesk_dev
APP_CORS_ALLOWED_ORIGIN=http://localhost:4200

# Obligatorio: genera un valor nuevo con `openssl rand -hex 32` y pégalo aquí.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=30

# Solo para desarrollo local con las cuentas demo. En cualquier entorno publicado: false.
APP_SEED_ENABLED=true
